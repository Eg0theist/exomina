{
  "name": "exomina",
  "version": "0.6.1",
  "private": true,
  "description": "Exomina desktop workspace",
  "author": "Exomina",
  "license": "Apache-2.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "prebuild": "node scripts/prepare-version.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "prepare:runtimes": "node scripts/prepare-beta-vendor.mjs && node scripts/prepare-grok-runtime.mjs && node scripts/prepare-analysis-node.mjs",
    "package": "node scripts/package-local.mjs",
    "package:mac": "node scripts/package-cross-platform.mjs darwin",
    "package:linux": "node scripts/package-cross-platform.mjs linux",
    "qa:package": "node scripts/qa-packaged.mjs",
    "qa:installer": "node scripts/qa-beta-installer.mjs",
    "version:sync": "node scripts/prepare-version.mjs",
    "package:public": "node scripts/release-windows.mjs",
    "package:official": "node scripts/package-official.mjs",
    "release:update": "node scripts/create-public-update.mjs",
    "security:check": "node scripts/security-maintenance.mjs --check",
    "security:prepare": "node scripts/security-maintenance.mjs --prepare",
    "package:beta": "npm run build && npm run prepare:runtimes && node scripts/prepare-taskbar-icon.mjs && node scripts/prepare-windows-interop.mjs && electron-builder --config scripts/private-beta-installer-config.mjs --win nsis --x64"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@lydell/node-pty": "1.1.0",
    "@muse-code/sdk": "1.4.13",
    "@openai/codex": "0.160.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "1.30.0",
    "playwright": "1.64.1",
    "qrcode": "1.5.4",
    "rea-agents": "6.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "rea-agents": {
      "zod": "4.6.7"
    }
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "local.exomina.desktop",
    "productName": "Exomina",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "!desktop/agent-spending.mjs",
      "!desktop/antigravity-browser/**",
      "vendor/**",
      "build/icon.png",
      "build/taskbar-icon.json",
      "build/shell-icons/**",
      "build/update-channel.json",
      "package.json",
      "README.md",
      "PROVIDER-TOOLS.md",
      "TERMINAL.md",
      "PUBLIC-UPDATES.md",
      "VALIDATION.txt",
      "THIRD-PARTY-NOTICES.txt",
      "SECURITY-AUDIT.txt",
      "scripts/install-windows.ps1",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "desktop/**",
      "vendor/**",
      "node_modules/**",
      "build/shell-icons/**",
      "scripts/install-windows.ps1"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "npmRebuild": false
  },
  "homepage": "https://github.com/Eg0theist/exomina",
  "optionalDependencies": {
    "@xai-official/grok-darwin-arm64": "1.0.46",
    "@xai-official/grok-darwin-x64": "1.0.46",
    "@xai-official/grok-linux-arm64": "1.0.46",
    "@xai-official/grok-linux-x64": "1.0.46",
    "@xai-official/grok-win32-arm64": "1.0.46",
    "@xai-official/grok-win32-x64": "1.0.46"
  }
}
