{
  "name": "exomina",
  "version": "0.7.1",
  "private": true,
  "description": "Exomina desktop workspace for AI, memory and tools",
  "author": "Exomina",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "prebuild": "node scripts/prepare-version.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "package": "node scripts/package-local.mjs",
    "stage": "node scripts/stage-build.mjs",
    "package:public": "node scripts/release-windows.mjs",
    "package:official": "node scripts/package-official.mjs",
    "release:update": "node scripts/create-public-update.mjs",
    "version:sync": "node scripts/prepare-version.mjs",
    "cloud:start": "node cloud/start.mjs",
    "preview:design": "vite --port 5179 --open /preview.html",
    "prepare:runtimes": "node scripts/prepare-beta-vendor.mjs && node scripts/prepare-grok-runtime.mjs && node scripts/prepare-analysis-node.mjs",
    "security:check": "node scripts/security-maintenance.mjs --check",
    "security:prepare": "node scripts/security-maintenance.mjs --prepare",
    "qa:package": "node scripts/qa-packaged.mjs",
    "qa:installer": "node scripts/qa-beta-installer.mjs",
    "package:mac": "node scripts/package-cross-platform.mjs darwin",
    "package:linux": "node scripts/package-cross-platform.mjs linux"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@muse-code/sdk": "1.4.14",
    "@openai/codex": "0.167.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "^0.577.0",
    "onnxruntime-node": "1.31.1",
    "playwright": "1.65.0",
    "qrcode": "1.5.4",
    "rea-agents": "6.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1"
  },
  "optionalDependencies": {
    "@xai-official/grok-darwin-arm64": "1.0.46",
    "@xai-official/grok-darwin-x64": "1.0.46",
    "@xai-official/grok-linux-arm64": "1.0.46",
    "@xai-official/grok-linux-x64": "1.0.46",
    "@xai-official/grok-win32-arm64": "1.0.46",
    "@xai-official/grok-win32-x64": "1.0.46"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob@>=9": "14.0.3",
    "@electron/asar": "4.3.1",
    "rea-agents": {
      "zod": "4.6.7"
    }
  },
  "build": {
    "beforePack": "./scripts/package-dependencies-before.mjs",
    "afterPack": "./scripts/package-dependencies-after.mjs",
    "electronDist": "node_modules/electron/dist",
    "appId": "local.exomina.desktop",
    "productName": "Exomina",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "!desktop/antigravity-browser/**",
      "vendor/**",
      "build/icon.png",
      "build/taskbar-icon.json",
      "build/shell-icons/**",
      "build/update-channel.json",
      "package.json",
      "README.md",
      "PROVIDER-TOOLS.md",
      "TERMINAL.md",
      "PUBLIC-UPDATES.md",
      "VALIDATION.txt",
      "THIRD-PARTY-NOTICES.txt",
      "SECURITY-AUDIT.txt",
      "scripts/install-windows.ps1",
      "LICENSE",
      "NOTICE",
      "!desktop/agent-spending.mjs"
    ],
    "asarUnpack": [
      "desktop/**",
      "vendor/**",
      "node_modules/**",
      "build/shell-icons/**",
      "scripts/install-windows.ps1"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "npmRebuild": false
  },
  "homepage": "https://github.com/Eg0theist/exomina",
  "license": "Apache-2.0"
}
