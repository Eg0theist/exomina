# Copy onto the encrypted server mount with permissions 0600.
# The production launcher refuses ordinary unencrypted storage.
EXOMINA_DATA_DIR=/var/lib/exomina/private
EXOMINA_PUBLIC_URL=https://YOUR-PRIVATE-SERVER
EXOMINA_OWNER_EMAIL=YOUR-GOOGLE-ACCOUNT
EXOMINA_GOOGLE_CLIENT_ID=YOUR-OAUTH-CLIENT-ID
EXOMINA_GOOGLE_CLIENT_SECRET=YOUR-OAUTH-CLIENT-SECRET
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a separate encrypted backup. Never commit actual values.
EXOMINA_VAULT_KEY=YOUR-32-BYTE-BASE64-KEY
EXOMINA_PORT=4178
EXOMINA_CODEX_PATH=/usr/local/bin/codex
EXOMINA_CLAUDE_PATH=/usr/local/bin/claude
